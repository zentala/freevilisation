# Normalize every text file to LF in the repository and in the working tree.
# Without this, core.autocrlf=true on Windows checks files out as CRLF and
# `prettier --check` fails locally while CI on Linux stays green.
* text=auto eol=lf

# Windows shells need CRLF to run reliably.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.glb binary
*.gltf binary
